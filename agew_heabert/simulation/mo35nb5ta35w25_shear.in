# ==============================================================================
#  Shear deformation of a MoNbTaW edge dislocation
#  Reproduction of the Osetsky-Bacon / Choi et al. method
#  [Choi et al., npj Comput. Mater. 4:1 (2018), Fig. 3]
#
#  Geometry (set by Atomsk when w.data was built):
#     x = [111]   glide direction = Burgers vector b = a*sqrt(3)/2
#     y = [1-10]  slip-plane normal = LOAD axis (rigid slabs top & bottom)
#     z = [11-2]  dislocation line
#  Edge dislocation already inserted in w.data (pure W, 5 atom types).
# Required command-line variables:
#   lmp -var data_file /path/to/w.data -var seed_file /path/to/seed
#       -var potential_dir /path/to/potentials -in mo35nb5ta35w25_shear.in
# The data file and interatomic potentials are external and not redistributed.
# ==============================================================================

# ----------------------------- 0. Global setup -------------------------------
units           metal
dimension       3
boundary        p s p              # x periodic (glide), y shrink-wrapped (free
                                   # surfaces + slabs), z periodic (line closes on itself)
atom_style      atomic

include         ${seed_file}       # provides: variable seed equal <integer>

# --------------------- 1. Read the pre-built dislocation ----------------------
# w.data: a = 3.242 A, 5 atom types declared, all atoms = type 5 (W).
# box  0..127.038984 (x) | 0..501.536698 (y) | 0..31.588620 (z)
read_data       ${data_file}

# ----------------------- 2. Random substitution -> alloy ----------------------
# Target = identical to in-stress:  Mo 35 / Ta 35 / W 25 / Nb 5  (at%)
# Built from the all-W (type 5) pool. Fractions re-derived for a W base so the
# FINAL totals match in-stress (which started from an all-Nb base):
#   step 1: 35.00% of W       -> Mo  =>  Mo = 0.3500
#   step 2: 53.80% of rest    -> Ta  =>  Ta = 0.65*0.5380          = 0.3497
#   step 3: 16.65% of rest    -> Nb  =>  Nb = 0.65*0.4620*0.1665   = 0.0500
#   remainder stays W                 =>  W  = 0.2503
set             type 5 type/ratio 1 0.3500 ${seed}     # -> Mo
set             type 5 type/ratio 3 0.3846 ${seed}     # -> Ta
set             type 5 type/ratio 2 0.1250 ${seed}     # -> Nb

mass            1 95.95            # Mo
mass            2 92.90637         # Nb
mass            3 180.94788        # Ta
mass            4 50.9415          # V  (absent in this alloy)
mass            5 183.84           # W

# ------------------------------ 3. Potential ----------------------------------
pair_style      hybrid/overlay eam/fs tabgap
pair_coeff      * * eam/fs  ${potential_dir}/Mo-Nb-Ta-V-W.eam.fs Mo Nb Ta V W
pair_coeff      * * tabgap  ${potential_dir}/Mo-Nb-Ta-V-W.tabgap Mo Nb Ta V W no yes

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# ------------------- 4. Define rigid slabs along y (load axis) ----------------
# Slab thickness ~13 A (~3 repeats of a*sqrt(2)=4.559). Bounds taken from the
# CURRENT (just-read) box; the ${...} forces immediate numeric substitution so
# the regions get fixed coordinates that do NOT drift later.
variable        slab    equal 13.0
variable        yb_lo   equal ylo
variable        yb_hi   equal yhi
variable        y_lobot equal "v_yb_lo+v_slab"
variable        y_uptop equal "v_yb_hi-v_slab"

region          rlower block INF INF INF ${y_lobot} INF INF units box
region          rupper block INF INF ${y_uptop} INF INF INF units box
group           lower    region rlower
group           upper    region rupper
group           boundary union lower upper
group           inner    subtract all boundary

# ------------------- 5. Relaxation (procedure from in-minimize) ---------------
thermo          100
thermo_style    custom step pe temp pxx pyy pzz pxy

# 5c. final hard CG to a 0 K minimum
min_style       cg
minimize        1.0e-18 1.0e-18 100000 100000
write_data      relaxed_edge.data

# ----------- 6. Per-atom core diagnostics (verify a clean 1/2[111] edge) ------
# VORONOI package unavailable -> normalize stress/atom by a fixed BCC atomic
# volume V_atom = a^3/2 = 16.7616 A^3.  (stress/atom is stress*volume in bar*A^3;
# divide by V_atom -> bar, then /1e4 -> GPa.)  Expression must be ONE space-free
# token, and a run/minimize must populate the compute before any dump reads it.
variable        vinv equal 2.0/(3.224^3)
compute         satom all stress/atom NULL
variable        Pa atom -(c_satom[1]+c_satom[2]+c_satom[3])/3.0*${vinv}/10000.0
variable        Pb atom sqrt((c_satom[4]^2)+(c_satom[5]^2))*${vinv}/10000.0

dump            dcore all custom 1 core_check.dump id type x y z v_Pa v_Pb
run             0                    # populates compute satom for the dump
undump          dcore
# >>> Inspect core_check.dump in OVITO (DXA + Burgers circuit) BEFORE shearing.

# --------------- 7. Shear deformation (quasi-static, displacement-controlled) -
#   Choi Fig. 3 method: rigid +x / -x displacement of the upper / lower slabs,
#   followed by CG minimization of the interior at each increment (athermal).
reset_timestep  0

variable        Lsep   equal "(v_yb_hi-v_yb_lo)-2.0*v_slab"     # slab inner-face gap
variable        dgamma equal 1.0e-2                             # shear-strain step
variable        Nsteps equal 30                                # total gamma ~ 0.05

# halfdu must be a FIXED number, evaluated ONCE now. Use $(...) immediate eval.
variable        halfdu equal $(0.5*v_dgamma*((v_yb_hi-v_yb_lo)-2.0*v_slab))

# Dynamic measurement variables (lazy-evaluated each time they are printed):
variable        g     equal "v_dgamma*v_i"                      # accumulated shear strain
variable        tpxy  equal "-pxy/10000.0"                      # shear stress (bar->GPa)

# Hold both slabs fully rigid throughout loading (frozen during each minimize;
# moved only by displace_atoms between minimizations).
fix             flo lower setforce 0.0 0.0 0.0
fix             fup upper setforce 0.0 0.0 0.0

min_style       cg
# min_modify     dmax 0.05          # uncomment if CG overshoots near glide events

# Record the gamma = 0 reference point, then loop.
run             0
print           "# i  gamma  tau_pxy(GPa)" file shear_stress_strain.txt screen no
print           "0 0.0 $(-pxy/10000.0)"    append shear_stress_strain.txt screen no

# Optional snapshots for visualizing glide (enable if desired):
# dump          dvis all custom 50000 shear.*.dump id type x y z v_Pa v_Pb

label           shearloop
variable        i loop ${Nsteps}
    displace_atoms upper move  ${halfdu} 0.0 0.0 units box
    displace_atoms lower move -${halfdu} 0.0 0.0 units box
    minimize    1.0e-10 1.0e-10 20000 20000
    if "$(v_i-10*floor(v_i/10))==0" then "write_data shear_${i}.data"
    print       "${i} ${g} ${tpxy}" append shear_stress_strain.txt screen no
    next        i
jump            SELF shearloop

write_data      sheared_final.data
